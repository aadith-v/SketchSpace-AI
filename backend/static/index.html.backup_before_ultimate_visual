<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>SketchSpace AI — Spatial Architectural Synthesis Studio</title>
  
  <!-- Architectural Typography System: Clash Display / Space Grotesk, Manrope, IBM Plex Mono -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:ital,wght@0,400;0,500;0,600;0,700;1,400&family=Manrope:wght@300;400;500;600;700;800&family=Space+Grotesk:wght@400;500;600;700&display=swap" rel="stylesheet">
  
  <style>
    /* ==========================================================================
       CINEMATIC MULTICOLOUR AURORA & SPATIAL ENVIRONMENT
       ========================================================================== */
    :root {
      /* Deep Spatial Foundation */
      --obsidian: #050711;
      --midnight: #090e1f;
      --deep-indigo: #121730;
      
      /* Vibrant Multicolour Spectrum */
      --electric-violet: #8a3ffc;
      --sapphire-blue: #0f62fe;
      --electric-cyan: #11eaff;
      --turquoise: #00f2c3;
      --magenta-vivid: #fa2a97;
      --rose-pink: #ff6384;
      --amber-warm: #ffb020;
      --soft-white: #f8fafc;
      --muted-grey: #a0aec0;
      
      /* Iridescent Glass & Translucent Surface Materials */
      --iridescent-border: linear-gradient(135deg, rgba(17, 234, 255, 0.45), rgba(138, 63, 252, 0.5), rgba(250, 42, 151, 0.45));
      --glass-surface-1: rgba(12, 18, 38, 0.82);
      --glass-surface-2: rgba(18, 26, 54, 0.72);
      --glass-surface-float: rgba(24, 34, 72, 0.9);
      --dark-edge: rgba(255, 255, 255, 0.1);
      
      --font-display: 'Space Grotesk', -apple-system, sans-serif;
      --font-body: 'Manrope', system-ui, -apple-system, sans-serif;
      --font-tech: 'IBM Plex Mono', monospace;

      --radius-xl: 24px;
      --radius-lg: 16px;
      --radius-md: 10px;
      --radius-sm: 6px;
    }

    * { box-sizing: border-box; margin: 0; padding: 0; }

    html {
      scroll-behavior: smooth;
    }

    body {
      background-color: var(--obsidian);
      color: var(--soft-white);
      font-family: var(--font-body);
      min-height: 100vh;
      display: flex;
      flex-direction: column;
      overflow-x: hidden;
      position: relative;
    }

    /* ==========================================================================
       LAYER 1: MULTI-COORDINATED ANIMATED AURORA LIGHT FIELDS
       ========================================================================== */
    .aurora-universe {
      position: fixed;
      top: 0; left: 0; width: 100vw; height: 100vh;
      pointer-events: none;
      z-index: 0;
      overflow: hidden;
    }

    .aurora-sphere {
      position: absolute;
      border-radius: 50%;
      filter: blur(85px);
      opacity: 0.45;
      mix-blend-mode: screen;
      will-change: transform;
      animation: floatAurora 24s infinite alternate ease-in-out;
    }

    .aurora-1 {
      top: -10%; left: -5%;
      width: 65vw; height: 60vh;
      background: radial-gradient(circle, rgba(138, 63, 252, 0.6) 0%, rgba(15, 98, 254, 0.35) 60%, transparent 80%);
      animation-duration: 22s;
    }

    .aurora-2 {
      top: 15%; right: -10%;
      width: 60vw; height: 65vh;
      background: radial-gradient(circle, rgba(17, 234, 255, 0.5) 0%, rgba(0, 242, 195, 0.3) 55%, transparent 75%);
      animation-duration: 26s;
      animation-delay: -5s;
    }

    .aurora-3 {
      bottom: -15%; left: 20%;
      width: 70vw; height: 60vh;
      background: radial-gradient(circle, rgba(250, 42, 151, 0.45) 0%, rgba(255, 99, 132, 0.25) 50%, transparent 75%);
      animation-duration: 28s;
      animation-delay: -10s;
    }

    .aurora-4 {
      top: 45%; left: 35%;
      width: 45vw; height: 45vh;
      background: radial-gradient(circle, rgba(255, 176, 32, 0.22) 0%, rgba(250, 42, 151, 0.18) 55%, transparent 75%);
      animation-duration: 32s;
      animation-delay: -15s;
    }

    @keyframes floatAurora {
      0% { transform: translate(0, 0) scale(1) rotate(0deg); }
      50% { transform: translate(5vw, 6vh) scale(1.12) rotate(15deg); }
      100% { transform: translate(-4vw, -5vh) scale(0.92) rotate(-10deg); }
    }

    /* Perspective Spatial Architectural Grid Floor */
    .spatial-grid-floor {
      position: fixed;
      top: 0; left: 0; width: 100vw; height: 100vh;
      pointer-events: none;
      z-index: 0;
      opacity: 0.35;
      background-image: 
        linear-gradient(to right, rgba(17, 234, 255, 0.12) 1px, transparent 1px),
        linear-gradient(to bottom, rgba(138, 63, 252, 0.12) 1px, transparent 1px);
      background-size: 56px 56px;
      mask-image: radial-gradient(ellipse at 50% 50%, black 35%, transparent 85%);
      -webkit-mask-image: radial-gradient(ellipse at 50% 50%, black 35%, transparent 85%);
    }

    /* Ambient Spatial Dust Particles */
    #ambient-particles-canvas {
      position: fixed;
      top: 0; left: 0; width: 100vw; height: 100vh;
      pointer-events: none;
      z-index: 1;
    }

    /* ==========================================================================
       LAYER 2: FLOATING 3D ARCHITECTURAL BACKGROUND SCULPTURES
       ========================================================================== */
    .floating-sculptures-layer {
      position: fixed;
      top: 0; left: 0; width: 100vw; height: 100vh;
      pointer-events: none;
      z-index: 1;
      overflow: hidden;
    }

    .sculpture-prism {
      position: absolute;
      transform-style: preserve-3d;
      will-change: transform;
      animation: floatSculpture 20s infinite ease-in-out;
    }

    .sculpture-1 {
      top: 18%; left: 4%;
      width: 140px; height: 140px;
      animation-duration: 24s;
    }
    .sculpture-2 {
      bottom: 22%; right: 5%;
      width: 170px; height: 170px;
      animation-duration: 30s;
      animation-delay: -8s;
    }
    .sculpture-3 {
      top: 55%; left: 88%;
      width: 110px; height: 110px;
      animation-duration: 20s;
      animation-delay: -14s;
    }

    @keyframes floatSculpture {
      0% { transform: translateY(0) rotateX(15deg) rotateY(20deg); }
      50% { transform: translateY(-30px) rotateX(35deg) rotateY(65deg); }
      100% { transform: translateY(0) rotateX(15deg) rotateY(20deg); }
    }

    .glass-plane {
      position: absolute;
      width: 100%; height: 100%;
      border: 1px solid rgba(17, 234, 255, 0.4);
      background: linear-gradient(135deg, rgba(17, 234, 255, 0.08), rgba(250, 42, 151, 0.06));
      backdrop-filter: blur(4px);
      box-shadow: 0 0 25px rgba(17, 234, 255, 0.15);
    }

    /* ==========================================================================
       TOP SPATIAL NAVIGATION & BRAND LOCKUP
       ========================================================================== */
    .spatial-nav {
      position: sticky;
      top: 0;
      z-index: 100;
      backdrop-filter: blur(24px);
      -webkit-backdrop-filter: blur(24px);
      background: rgba(7, 10, 24, 0.75);
      border-bottom: 1px solid rgba(255, 255, 255, 0.1);
      box-shadow: 0 8px 32px rgba(0, 0, 0, 0.35);
      padding: 14px 44px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 20px;
    }

    .spatial-brand {
      display: flex;
      align-items: center;
      gap: 16px;
      text-decoration: none;
      color: inherit;
      cursor: pointer;
    }

    .brand-cube-badge {
      width: 46px;
      height: 46px;
      border-radius: 12px;
      background: linear-gradient(135deg, rgba(17, 234, 255, 0.2), rgba(138, 63, 252, 0.35), rgba(250, 42, 151, 0.25));
      border: 1px solid rgba(17, 234, 255, 0.55);
      display: flex;
      align-items: center;
      justify-content: center;
      box-shadow: 0 0 25px rgba(17, 234, 255, 0.35);
      position: relative;
      transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1);
    }
    .spatial-brand:hover .brand-cube-badge {
      transform: scale(1.08) rotate(4deg);
    }

    .brand-text-lockup h1 {
      font-family: var(--font-display);
      font-size: 1.48rem;
      font-weight: 700;
      letter-spacing: -0.03em;
      background: linear-gradient(135deg, #ffffff 30%, var(--electric-cyan) 75%, var(--magenta-vivid) 100%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      display: flex;
      align-items: center;
      gap: 8px;
    }

    .brand-text-lockup p {
      font-family: var(--font-tech);
      font-size: 0.72rem;
      color: var(--muted-grey);
      letter-spacing: 0.04em;
    }

    .spatial-nav-tabs {
      display: flex;
      align-items: center;
      gap: 6px;
      background: rgba(12, 18, 38, 0.75);
      padding: 4px;
      border-radius: 14px;
      border: 1px solid var(--dark-edge);
      box-shadow: inset 0 1px 3px rgba(0, 0, 0, 0.3);
    }

    .nav-link-btn {
      background: transparent;
      border: none;
      color: var(--muted-grey);
      font-family: var(--font-body);
      font-size: 0.84rem;
      font-weight: 600;
      padding: 8px 18px;
      border-radius: 10px;
      cursor: pointer;
      transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
      display: flex;
      align-items: center;
      gap: 8px;
    }
    .nav-link-btn:hover {
      color: var(--soft-white);
      background: rgba(255, 255, 255, 0.06);
    }
    .nav-link-btn.active {
      color: var(--soft-white);
      background: linear-gradient(135deg, rgba(17, 234, 255, 0.25), rgba(138, 63, 252, 0.3));
      border: 1px solid rgba(17, 234, 255, 0.45);
      box-shadow: 0 0 20px rgba(17, 234, 255, 0.25);
    }

    .engine-status-tag {
      display: flex;
      align-items: center;
      gap: 9px;
      padding: 7px 16px;
      border-radius: 20px;
      background: rgba(0, 242, 195, 0.1);
      border: 1px solid rgba(0, 242, 195, 0.35);
      color: var(--turquoise);
      font-family: var(--font-tech);
      font-size: 0.74rem;
      font-weight: 500;
    }
    .beacon-pulse {
      width: 7px;
      height: 7px;
      border-radius: 50%;
      background: var(--turquoise);
      box-shadow: 0 0 12px var(--turquoise);
      animation: beaconPulse 2s infinite ease-in-out;
    }
    @keyframes beaconPulse {
      0%, 100% { opacity: 0.35; transform: scale(0.9); }
      50% { opacity: 1; transform: scale(1.3); }
    }

    .btn-presentation-pill {
      background: rgba(138, 63, 252, 0.18);
      border: 1px solid rgba(138, 63, 252, 0.4);
      color: #d4bbff;
      font-family: var(--font-tech);
      font-size: 0.74rem;
      padding: 6px 14px;
      border-radius: 20px;
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      gap: 6px;
      transition: all 0.2s ease;
    }
    .btn-presentation-pill:hover {
      background: rgba(138, 63, 252, 0.35);
      border-color: var(--electric-violet);
      color: #fff;
    }

    /* Main Container Shell */
    .main-spatial-container {
      position: relative;
      z-index: 2;
      width: 100%;
      max-width: 1540px;
      margin: 0 auto;
      padding: 36px 44px 64px;
      display: flex;
      flex-direction: column;
      gap: 40px;
    }

    /* ==========================================================================
       SECTION 1: CINEMATIC MULTICOLOUR HERO WITH LARGE 3D SPATIAL ROOM
       ========================================================================== */
    .hero-spatial-section {
      position: relative;
      padding: 72px 48px 60px;
      border-radius: var(--radius-xl);
      background: linear-gradient(145deg, rgba(12, 18, 38, 0.88) 0%, rgba(7, 10, 24, 0.96) 100%);
      border: 1px solid rgba(255, 255, 255, 0.12);
      box-shadow: 0 28px 70px rgba(0, 0, 0, 0.5), inset 0 1px 0 rgba(255, 255, 255, 0.12);
      overflow: hidden;
      display: grid;
      grid-template-columns: 1.15fr 0.85fr;
      gap: 40px;
      align-items: center;
    }

    @media (max-width: 1080px) {
      .hero-spatial-section { grid-template-columns: 1fr; text-align: center; }
      .hero-editorial-left { align-items: center; }
    }

    .hero-editorial-left {
      display: flex;
      flex-direction: column;
      gap: 22px;
      text-align: left;
      z-index: 2;
    }

    .hero-tagline-badge {
      display: inline-flex;
      align-items: center;
      gap: 10px;
      padding: 6px 18px;
      border-radius: 30px;
      background: rgba(17, 234, 255, 0.12);
      border: 1px solid rgba(17, 234, 255, 0.4);
      color: var(--electric-cyan);
      font-family: var(--font-tech);
      font-size: 0.76rem;
      font-weight: 600;
      letter-spacing: 0.06em;
      text-transform: uppercase;
      align-self: flex-start;
      box-shadow: 0 0 15px rgba(17, 234, 255, 0.2);
    }

    .hero-editorial-headline {
      font-family: var(--font-display);
      font-size: clamp(2.8rem, 4.4vw, 4.4rem);
      font-weight: 700;
      line-height: 1.08;
      letter-spacing: -0.04em;
      background: linear-gradient(135deg, #ffffff 15%, var(--electric-cyan) 55%, var(--magenta-vivid) 85%, var(--amber-warm) 100%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      text-shadow: 0 0 50px rgba(17, 234, 255, 0.35);
    }

    .hero-editorial-lead {
      font-size: 1.14rem;
      color: var(--muted-grey);
      line-height: 1.68;
      max-width: 580px;
    }

    .hero-cta-cluster {
      display: flex;
      align-items: center;
      gap: 18px;
      flex-wrap: wrap;
      margin-top: 8px;
    }

    .btn-spatial-primary {
      background: linear-gradient(135deg, var(--electric-cyan) 0%, var(--electric-violet) 50%, var(--magenta-vivid) 100%);
      color: var(--obsidian);
      font-family: var(--font-display);
      font-weight: 700;
      font-size: 1.04rem;
      padding: 16px 38px;
      border-radius: var(--radius-md);
      border: none;
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      gap: 10px;
      box-shadow: 0 0 32px rgba(17, 234, 255, 0.45);
      transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
    }
    .btn-spatial-primary:hover {
      transform: translateY(-3px) scale(1.02);
      box-shadow: 0 0 50px rgba(250, 42, 151, 0.6);
    }

    .btn-spatial-secondary {
      background: rgba(18, 26, 54, 0.75);
      color: var(--soft-white);
      font-family: var(--font-display);
      font-weight: 600;
      font-size: 1rem;
      padding: 16px 30px;
      border-radius: var(--radius-md);
      border: 1px solid rgba(255, 255, 255, 0.15);
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      gap: 10px;
      transition: all 0.2s ease;
    }
    .btn-spatial-secondary:hover {
      background: rgba(26, 38, 76, 0.95);
      border-color: rgba(17, 234, 255, 0.55);
      transform: translateY(-2px);
    }

    /* ==========================================================================
       SECTION 7: LARGE INTERACTIVE 3D ARCHITECTURAL ROOM ENVIRONMENT
       ========================================================================== */
    .hero-spatial-stage-right {
      position: relative;
      width: 100%;
      height: 420px;
      perspective: 1100px;
      display: flex;
      align-items: center;
      justify-content: center;
      user-select: none;
    }

    .large-room-3d {
      width: 290px;
      height: 190px;
      position: relative;
      transform-style: preserve-3d;
      transform: rotateX(24deg) rotateY(-36deg);
      animation: rotateSpatialRoom 24s infinite linear;
      transition: transform 0.25s ease-out;
    }
    @keyframes rotateSpatialRoom {
      0% { transform: rotateX(24deg) rotateY(0deg); }
      100% { transform: rotateX(24deg) rotateY(360deg); }
    }

    .room-wall-panel {
      position: absolute;
      width: 290px;
      height: 190px;
      border: 1px solid rgba(17, 234, 255, 0.5);
      background: linear-gradient(135deg, rgba(17, 234, 255, 0.08), rgba(138, 63, 252, 0.06));
      backdrop-filter: blur(6px);
      box-shadow: inset 0 0 25px rgba(138, 63, 252, 0.2);
    }
    .room-wall-panel.front  { transform: translateZ(145px); }
    .room-wall-panel.back   { transform: rotateY(180deg) translateZ(145px); }
    .room-wall-panel.right  { width: 290px; transform: rotateY(90deg) translateZ(145px); }
    .room-wall-panel.left   { width: 290px; transform: rotateY(-90deg) translateZ(145px); }
    .room-wall-panel.ceiling { height: 290px; transform: rotateX(90deg) translateZ(95px); border-color: rgba(250, 42, 151, 0.45); }
    .room-wall-panel.floor   { height: 290px; transform: rotateX(-90deg) translateZ(95px); background: rgba(17, 234, 255, 0.16); }

    /* Window Aperture Cutout Silhouette */
    .wall-window-frame {
      position: absolute;
      top: 30px; left: 45px;
      width: 100px; height: 110px;
      border: 2px solid var(--electric-cyan);
      box-shadow: 0 0 15px var(--electric-cyan);
      background: rgba(17, 234, 255, 0.12);
    }

    /* Abstract Floating Furniture Block Inside 3D Room */
    .furniture-cube {
      position: absolute;
      width: 110px; height: 45px;
      bottom: 20px; left: 45px;
      transform: translateZ(20px);
      border: 1px solid var(--magenta-vivid);
      background: rgba(250, 42, 151, 0.2);
      box-shadow: 0 0 15px rgba(250, 42, 151, 0.35);
    }

    /* Floating Material Tiles */
    .floating-material-sample {
      position: absolute;
      padding: 6px 14px;
      border-radius: 8px;
      font-family: var(--font-tech);
      font-size: 0.7rem;
      backdrop-filter: blur(8px);
      box-shadow: 0 4px 20px rgba(0, 0, 0, 0.4);
    }
    .sample-1 {
      top: -20px; left: -10px;
      background: rgba(17, 234, 255, 0.18);
      border: 1px solid var(--electric-cyan);
      color: var(--electric-cyan);
    }
    .sample-2 {
      bottom: -15px; right: -15px;
      background: rgba(250, 42, 151, 0.18);
      border: 1px solid var(--magenta-vivid);
      color: var(--magenta-vivid);
    }

    /* Spatial Dimension HUD Overlay Annotations */
    .spatial-dim-badge {
      position: absolute;
      top: 14px; right: 14px;
      background: rgba(7, 10, 24, 0.85);
      border: 1px solid rgba(17, 234, 255, 0.45);
      padding: 6px 14px;
      border-radius: 8px;
      font-family: var(--font-tech);
      font-size: 0.72rem;
      color: var(--electric-cyan);
      box-shadow: 0 0 15px rgba(17, 234, 255, 0.2);
    }

    /* ==========================================================================
       SIGNATURE SKETCH-TO-REALITY STORYTELLING SECTION
       ========================================================================== */
    .sketch-to-reality-showcase {
      display: flex;
      flex-direction: column;
      gap: 24px;
      padding: 44px;
      background: linear-gradient(135deg, rgba(12, 18, 38, 0.82), rgba(18, 26, 54, 0.7));
      border: 1px solid rgba(255, 255, 255, 0.12);
      border-radius: var(--radius-xl);
      box-shadow: 0 20px 50px rgba(0, 0, 0, 0.35);
      position: relative;
    }

    .story-header-row {
      display: flex;
      justify-content: space-between;
      align-items: flex-end;
      flex-wrap: wrap;
      gap: 16px;
    }

    .story-stage-cards {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 20px;
      margin-top: 12px;
    }
    @media (max-width: 900px) {
      .story-stage-cards { grid-template-columns: 1fr 1fr; }
    }
    @media (max-width: 580px) {
      .story-stage-cards { grid-template-columns: 1fr; }
    }

    .story-step-item {
      background: rgba(18, 26, 54, 0.75);
      border: 1px solid rgba(255, 255, 255, 0.08);
      border-radius: var(--radius-lg);
      padding: 18px;
      display: flex;
      flex-direction: column;
      gap: 10px;
      transition: all 0.25s ease;
      position: relative;
      overflow: hidden;
    }
    .story-step-item:hover {
      border-color: rgba(17, 234, 255, 0.55);
      transform: translateY(-5px);
      box-shadow: 0 12px 30px rgba(17, 234, 255, 0.15);
    }
    .story-step-item::before {
      content: "";
      position: absolute;
      top: 0; left: 0; width: 100%; height: 3px;
      background: linear-gradient(90deg, var(--electric-cyan), var(--electric-violet), var(--magenta-vivid));
    }
    .story-step-label {
      font-family: var(--font-tech);
      font-size: 0.72rem;
      font-weight: 700;
      color: var(--electric-cyan);
      letter-spacing: 0.08em;
      text-transform: uppercase;
    }
    .story-step-title {
      font-family: var(--font-display);
      font-size: 1.08rem;
      font-weight: 700;
      color: var(--soft-white);
    }
    .story-step-desc {
      font-size: 0.82rem;
      color: var(--muted-grey);
      line-height: 1.5;
    }

    /* ==========================================================================
       CREATIVE STUDIO WORKSPACE
       ========================================================================== */
    .studio-spatial-section {
      display: flex;
      flex-direction: column;
      gap: 24px;
    }

    .studio-workspace-grid {
      display: grid;
      grid-template-columns: 1.05fr 1fr;
      gap: 28px;
      align-items: start;
    }
    @media (max-width: 1140px) {
      .studio-workspace-grid { grid-template-columns: 1fr; }
    }

    /* Spatial Glass Panels */
    .spatial-panel {
      background: var(--glass-surface-1);
      backdrop-filter: blur(20px);
      -webkit-backdrop-filter: blur(20px);
      border: 1px solid rgba(255, 255, 255, 0.1);
      border-radius: var(--radius-xl);
      padding: 24px;
      display: flex;
      flex-direction: column;
      gap: 20px;
      box-shadow: 0 20px 50px rgba(0, 0, 0, 0.45);
      position: relative;
    }

    .panel-head-spatial {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding-bottom: 16px;
      border-bottom: 1px solid var(--dark-edge);
    }

    .panel-headline {
      display: flex;
      align-items: center;
      gap: 14px;
    }

    .spatial-orb {
      width: 42px;
      height: 42px;
      border-radius: 12px;
      background: rgba(17, 234, 255, 0.14);
      border: 1px solid rgba(17, 234, 255, 0.4);
